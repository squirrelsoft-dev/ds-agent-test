# Copy to .env and fill in.
# The agent uses the OpenAI SDK, so it works with OpenAI or any
# OpenAI-compatible endpoint (LiteLLM proxy, local server, etc.).
OPENAI_API_KEY=your-key-here
# Optional: override the default model.
# AGENT_MODEL=gpt-4o-mini
# Optional: point at an OpenAI-compatible base URL.
# OPENAI_BASE_URL=https://api.openai.com/v1
# Optional: OTLP endpoint for OpenTelemetry trace export.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
